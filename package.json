{
  "name": "direnv-vscode-profile",
  "displayName": "direnv VSCode Profile",
  "version": "0.1.0",
  "description": "Auto-switch VSCode profiles using direnv and environment variables",
  "categories": [
    "Other"
  ],
  "homepage": "https://github.com/Passeriform/direnv-vscode-profile#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Passeriform/direnv-vscode-profile"
  },
  "publisher": "passeriform",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsup src/extension.ts --dts --external=vscode",
    "dev": "npm run build -- --watch",
    "lint": "oxlint",
    "lint:fix": "oxfmt"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.52.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "mkhl.direnv"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.52.0"
  }
}
