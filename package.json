{
  "name": "direnv-vscode-profile",
  "displayName": "direnv VSCode Profile",
  "description": "Auto-switch VSCode profiles using direnv and environment variables",
  "author": "Passeriform",
  "publisher": "Passeriform",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "vscode": "^1.84.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Passeriform/direnv-vscode-profile.git#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Passeriform/direnv-vscode-profile.git"
  },
  "bugs": {
    "url": "https://github.com/Passeriform/direnv-vscode-profile.git/issues"
  },
  "icon": "assets/icon.png",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "mkhl.direnv"
  ],
  "main": "./dist/extension.cjs",
  "browser": "./dist/extension.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint",
    "lint:fix": "oxfmt",
    "test": "vitest",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "commit-and-tag-version": "^12.7.3",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.3"
  }
}
